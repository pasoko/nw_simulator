# Simple Dockerfile that uses pre-built files
FROM nginx:alpine

# Copy nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Copy pre-built files
COPY www/dist /usr/share/nginx/html

# Copy health check file
COPY www/health.html /usr/share/nginx/html/

# Expose port 80
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]