{
  "name": "nw_simulator",
  "version": "0.1.0",
  "description": "OSPF Network Simulator - WebAssembly & Rust implementation",
  "license": "MIT",
  "author": "pasoko",
  "repository": {
    "type": "git",
    "url": "https://github.com/pasoko/nw_simulator.git"
  },
  "packageManager": "yarn@4.9.2",
  "volta": {
    "node": "22.17.0",
    "yarn": "4.9.2"
  },
  "scripts": {
    "build": "wasm-pack build --target web --out-dir www/pkg",
    "build-www": "cd www && yarn build",
    "start": "cd www && yarn start",
    "setup": "yarn install && cd www && yarn install",
    "docker:build": "docker build -t ospf-network-simulator:latest .",
    "docker:run": "docker-compose up -d",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up"
  }
}
