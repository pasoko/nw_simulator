# Development Dockerfile with hot reload
FROM rust:1.79

# Install wasm-pack
RUN curl https://rustwasm.github.io/wasm-pack/installer/init.sh -sSf | sh

# Install Node.js and Yarn
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    npm install -g yarn  # npm is used here only to bootstrap Yarn

# Install watchexec for auto-rebuild (use compatible version with locked dependencies)
RUN cargo install watchexec-cli --version 1.20.6 --locked

WORKDIR /app

# Copy package files first for better caching
COPY www/package.json www/yarn.lock* ./www/

# Install dependencies with Yarn
WORKDIR /app/www
RUN yarn install

WORKDIR /app

# Copy the rest of the application
COPY . .

# Make scripts executable
RUN chmod +x build.sh

# Expose webpack dev server port
EXPOSE 8080

# Start development environment
CMD ["sh", "-c", "watchexec -w src -w Cargo.toml './build.sh' & cd www && yarn start"]